environment {
    XDG_CURRENT_DESKTOP "niri"
    NIXOS_OZONE_WL "1"
    XDG_SESSION_TYPE "wayland"
}

prefer-no-csd


layout {
    border {
        off
    }

    focus-ring {
        on
        width 1

        // Gruvbox orange bright
        active-color "#fe8019"

        // Gruvbox dark gray
        inactive-color "#3c3836"

        // Gruvbox red
        urgent-color "#fb4934"
    }

    shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
}

input {
    keyboard {
        xkb {
            layout "us"
            variant "colemak"
        }
    }
}

binds {
	Mod+Return { spawn "alacritty"; }
	Mod+Space { spawn "wofi" "--show" "drun" "--allow-images"; }

	Mod+Q { close-window; }
	Mod+Shift+F { toggle-window-floating; }

    Print { spawn "~/.config/niri/scripts/screenshot.sh"; }
	Mod+Shift+Print { spawn "/home/tutela/.config/niri/scripts/save_screenshot.sh"; }
	Mod+V {
        spawn "sh" "-c" "cliphist list | wofi --dmenu | cliphist decode | wl-copy";
    }

	// Maximizar coluna
    Mod+F { maximize-column; }
    // Alternar largura da coluna
    Mod+R { switch-preset-column-width; }
	Mod+Minus { set-column-width "-10%"; }
	Mod+Equal { set-column-width "+10%"; }

	// Centralizar janela
    Mod+C { center-column; }
	// Overview/workspace exposé
    Mod+Tab { toggle-overview; }

	XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
	
	Mod+Left { focus-column-left; }
	Mod+Right { focus-column-right; }
	Mod+Up { focus-window-up; }
	Mod+Down { focus-window-down; }

	Mod+Shift+Left { move-column-left; }
	Mod+Shift+Right { move-column-right; }
	Mod+Shift+Up { move-window-up; }
	Mod+Shift+Down { move-window-down; }

	Mod+1 { focus-workspace 1; }
	Mod+2 { focus-workspace 2; }
	Mod+3 { focus-workspace 3; }
	Mod+4 { focus-workspace 4; }
	Mod+5 { focus-workspace 5; }

	Mod+Shift+1 { move-column-to-workspace 1; }
	Mod+Shift+2 { move-column-to-workspace 2; } 
	Mod+Shift+3 { move-column-to-workspace 3; }
	Mod+Shift+4 { move-column-to-workspace 4; }
	Mod+Shift+5 { move-column-to-workspace 5; }
}

spawn-at-startup "swaybg" "-i" "/home/tutela/Pictures/castle.jpg" "-m" "fill"
spawn-at-startup "waybar";
spawn-at-startup "mako";

spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store";
spawn-at-startup "sh" "-c" "wl-paste --primary --watch cliphist store";


spawn-at-startup "systemctl" "--user" "import-environment" \
    "WAYLAND_DISPLAY" \
    "XDG_CURRENT_DESKTOP" \
    "NIRI_SOCKET" \
    "DISPLAY";

spawn-at-startup "dbus-update-activation-environment" "--systemd" \
    "WAYLAND_DISPLAY" \
    "XDG_CURRENT_DESKTOP" \
    "NIRI_SOCKET" \
    "DISPLAY";